# ====================================================================
# WHATSAPP AUTO-SAVER (LEVEL 1) - CONFIGURATION
# ====================================================================

# Supabase Project Credentials (Found in Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-service-role-or-anon-key"

# Supabase Storage Bucket Name for media (voices, images, videos)
SUPABASE_BUCKET="whatsapp-media"

# Target Filter (Optional)
# Enter the phone number (with country code, e.g., 12345678900) or exact contact name of the person
# you want to save messages from (e.g., your girlfriend).
# Leave empty to save messages from ALL incoming chats.
TARGET_FILTER=""

# Media Download Settings
# Max size in Megabytes for downloading incoming images, voice notes, and videos.
MEDIA_DOWNLOAD_LIMIT_MB=25

# Debug / Logging Level (true = verbose logs, false = normal logs)
DEBUG_MODE=true
